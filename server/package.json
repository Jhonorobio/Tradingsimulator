{
  "name": "trading-simulator-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for meme trading simulator: gmgn-cli wrapper, Jupiter/Dexscreener proxy, simulated trading engine and push notifications.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "node scripts/patch-gmgn-signer.js && node scripts/patch-cffi-idn2.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "optionalDependencies": {
    "@curl-cffi-node/linux-x64-gnu": "0.1.8",
    "@curl-cffi-node/linux-arm64-gnu": "0.1.8",
    "@curl-cffi-node/darwin-x64": "0.1.8",
    "@curl-cffi-node/darwin-arm64": "0.1.8",
    "@curl-cffi-node/win32-x64-msvc": "0.1.8"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "curl-cffi-node": "^0.1.8",
    "cycletls": "^2.0.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gmgn-cli": "^1.5.7",
    "got": "^15.1.0",
    "https-proxy-agent": "^7.0.6",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.3"
  }
}
