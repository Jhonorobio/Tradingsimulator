# Server port
PORT=4000

# SQLite data directory (Railway: mount a volume here, e.g. /data). Defaults to server/data.
# DATA_DIR=/data

# Path to the gmgn-cli binary (defaults to the node_modules copy, then PATH).
# GMGN_BIN=

# Poll interval (minutes) for push notification watcher
NOTIFY_INTERVAL_MIN=5

# Optional GMGN config path (defaults to ~/.config/gmgn/.env)
# GMGN_CONFIG_DIR=

# Max results per trenches category
TRENCHES_LIMIT=80

# Trenches server cache TTL (seconds). The app polls all categories every 1s;
# this caps how often GMGN is actually queried per unique filter set. Lower =
# fresher data but more GMGN API calls. Tune to your GMGN rate limit.
TRENCHES_CACHE_TTL=1

# Dedicated GMGN key used for the Trenches views. When set, trenches are
# fetched DIRECTLY over HTTPS from openapi.gmgn.ai (no gmgn-cli spawn, no
# proxy), sharing a single key across all three categories. Each category
# refreshes every ~1s (TTL above). If unset, falls back to the pins/proxies
# below, then to gmgn-cli.
# GMGN_API_KEY=gmgn_xxx

# Background refresher for the app's default trenches tabs. Runs one worker per
# category in parallel; each category refreshes in GMGN every ~3-4s, spread
# smoothly (no bursts).
# This value is the "rest" between picks in seconds (default 0.5).
TRENCHES_REFRESH_SEC=0.5

# Optional per-category proxy+key pins for the Trenches refresher. JSON keyed
# by tab (new_creation / near_completion / completed). Each pinned category is
# fetched DIRECTLY from the GMGN OpenAPI (https-proxy-agent + X-APIKEY — the
# same connection method used by the dashboard and token detail). At startup the
# server resolves each proxy's real egress IP: one worker per DISTINCT IP.
# Three genuinely different IPs give you ~3-4s per category without tripping
# the per-IP rate limit; proxies that all share one egress IP collapse to a
# single safe worker (pins still honored). Unpinned tabs fall back to
# TRENCHES_PROXIES/TRENCHES_KEYS positional lists, then to gmgn-cli.
# TRENCHES_PINS={"new_creation":{"proxy":"http://x:1","apiKey":"gmgn_xxx"},"near_completion":{"proxy":"http://y:2","apiKey":"gmgn_yyy"},"completed":{"proxy":"http://z:3","apiKey":"gmgn_zzz"}}
# TRENCHES_PROXIES=http://147.161.246.16:10800,http://85.8.47.198:7080,http://85.8.47.208:7080
# TRENCHES_KEYS=gmgn_xxx,gmgn_yyy,gmgn_zzz

# Default simulated budget (USDC)
DEFAULT_BUDGET=10000

# Default simulated gas per trade (USDC)
DEFAULT_GAS=0.25

# Clock offset (seconds) applied to GMGN request timestamps.
# Needed because the system clock is ahead of the GMGN server and otherwise
# the CLI fails with AUTH_TIMESTAMP_EXPIRED (GMGN validates within ±5s).
# Requires the signer.js patch (see README). Set to 0 if your clock is synced.
GMGN_TIME_OFFSET=44

# GMGN proxy — dedicated 2nd GMGN API key used as the primary source for token
# detail-page market cap/price and position valuations. HTTPS forward proxy
# (openapi.gmgn.ai). Falls back to Dexscreener when unreachable.
# GMGN_PROXY_URL=http://103.237.102.191:11111
# GMGN_PROXY_KEY=gmgn_xxx